{
  "server": {
    "base_url": "http://127.0.0.1:30000",
    "model": "Qwen/Qwen2.5-7B-Instruct",
    "tokenizer": null,
    "ready_timeout_seconds": 300,
    "flush_before_run": true,
    "clear_storage_before_run": false
  },
  "storage": {
    "path": "/root/data/sglang-hicache",
    "device": null,
    "transfer_trace_glob": null,
